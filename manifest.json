{
  "name": "tab-manager",
  "description": "Modern Chrome Extension to manage tabs",
  "version": "2.0.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [],
  "action": {
    "default_icon": "images/vertical.png",
    "default_popup": "popup.html",
    "default_title": "Tab Manager"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "MacCtrl+Shift+F"
      }
    }
  }
}
