{
  "name": "tab-manager",
  "version": "0.0.1",
  "description": "List and manage all open tabs across windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:full": "npm run build && cp -r images dist/ && cp manifest.json dist/ && cp README.md dist/README.md",
    "watch": "vite build --watch",
    "watch:full": "nodemon --watch src --ext ts,tsx,css --exec 'npm run build:full'",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.256",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "nodemon": "^3.0.2",
    "typescript": "^5.3.3",
    "vite": "^4.5.0"
  }
}
